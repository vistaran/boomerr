# ==============================================================================
# Boomerr - Open-Source Self-Hosted Website Monitoring Platform
# Root Environment Configuration File
# ==============================================================================

# Application General
APP_NAME=Boomerr
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
HTTP_PORT=8080

# Billing & Plans (false = Community Edition with unlimited monitors, team members & features)
ENABLE_BILLING=false

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MariaDB 11 in Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=boomerr
DB_USERNAME=boomerr
DB_PASSWORD=secret_db_password
MYSQL_ROOT_PASSWORD=secret_root_password

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Real-Time WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=boomerr-app
REVERB_APP_KEY=boomerr-key
REVERB_APP_SECRET=boomerr-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Global Edge Monitoring & Probe API Key
MONITORING_API_KEY=boomerr_monitoring_secret_key

# Frontend Environment Variables (Built into SPA)
VITE_SERVER_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_REVERB_APP_KEY=boomerr-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# File Storage (default: local public disk)
FILESYSTEM_DISK=public

# Optional: AWS S3 Storage (if FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: Email Service (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: hCaptcha Human Verification (leave empty to disable captcha)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
VITE_HCAPTCHA_SITE_KEY=

# Optional: SMS Alerts (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: WhatsApp Alerts (Meta Cloud API)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=

# Optional: AI Diagnostics
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Third-Party OAuth & Integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
