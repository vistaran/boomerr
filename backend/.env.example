APP_NAME=Boomerr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=En

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SYSTEM_LOGS_QUEUE=system-logs
SYSTEM_LOGS_SENSITIVE_RETENTION_DAYS=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=boomerr-local
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3-pro-preview

# Facebook Ads OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/integrations/facebook/callback

# WhatsApp Provider Selection: facebook or twilio
WHATSAPP_PROVIDER=facebook
WHATSAPP_TEMPLATE_LANGUAGE=En
WHATSAPP_TEMPLATE_OTP=otp_verification
WHATSAPP_TEMPLATE_DOMAIN_ALERT=boomerr_domain_ssl_alert
WHATSAPP_TEMPLATE_SSL_ALERT=boomerr_domain_ssl_alert

# Meta (Facebook) WhatsApp Cloud API
FACEBOOK_API_URL=https://graph.facebook.com/v22.0
FACEBOOK_WHATSAPP_PHONE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_WHATSAPP_VERIFY_TOKEN=
FACEBOOK_WHATSAPP_WEBHOOK_SECRET=

# Twilio API Credentials
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# SMS Provider Selection: msg91 or twilio
SMS_PROVIDER=msg91

# MSG91 API Credentials
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_ID=
MSG91_FLOW_ID_DEFAULT=
MSG91_FLOW_ID_OTP=
MSG91_FLOW_ID_DOMAIN_DOWN=
MSG91_FLOW_ID_DOMAIN_UP=
MSG91_FLOW_ID_SSL_ALERT=
MSG91_FLOW_ID_TEST=

# Google Ads API Credentials
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:8080/integrations/google/callback

# Monitoring Service
MONITORING_API_KEY=
LAMBDA_FUNCTION_NAME=boomerr-monitor
MONITORING_HTTP_TIMEOUT=20
MONITORING_SSL_TIMEOUT=15
MONITORING_SSL_HTTP_TIMEOUT=10
